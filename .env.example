# Copy to .env and adjust for your environment.
# Never commit real secrets.

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# JSON logs on stdout (true/false)
LOG_JSON=false

# Maestro / device (examples; wire these when integrating Maestro)
# MAESTRO_DEVICE_ID=
# MAESTRO_PLATFORM=android
# MAESTRO_APP_ID=com.example.app
